          "interpreterVersion": 1,
          "code": "/**\n * Seat: two wide panels resting on the runners' seat slope,\n * which runs from the runner front top A(0,380) down to the seat rear B(460,300).\n * The front of the seat overhangs to cover the apron.\n * The runner top tabs (Frame molecule, centres 110 and 350 mm along the slope, 60 long)\n * lock into dogboned notches along each panel's outside edge.\n */\nfunction run(\n  thickness: number = 19.05,\n  seatWidth: number = 560,\n  bitDiameter: number = 6.35,\n  clearance: number = 0.2,\n  gap: number = 6,\n): Assembly[] {\n  const T = thickness;\n  const W = seatWidth;\n  const c = clearance;\n  const r = (bitDiameter / 2) * 1.02;\n  const wood = \"#C8894F\";\n  const A = [0, 380];\n  const B = [460, 300];\n  const a = Math.atan2(A[1] - B[1], B[0] - A[0]);\n  const depth = Math.hypot(B[0] - A[0], B[1] - A[1]); // along the slope\n  const seatTabs = [110, 350];\n  const seatTabLen = 60;\n\n  const poly = (pts: number[][]) => {\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n    return pen.close();\n  };\n  const rect = (u0: number, u1: number, v0: number, v1: number) => [[u0, v0], [u1, v0], [u1, v1], [u0, v1]];\n  // Dogboned slot: bit centre r from each corner along the bisector.\n  const slot = (u0: number, u1: number, v0: number, v1: number) => {\n    let d = poly(rect(u0, u1, v0, v1));\n    const k = r / Math.SQRT2;\n    for (const [x, y, sx, sy] of [[u0, v0, 1, 1], [u1, v0, -1, 1], [u1, v1, -1, -1], [u0, v1, 1, -1]]) {\n      d = d.fuse(replicad.drawCircle(r).translate(x + sx * k, y + sy * k));\n    }\n    return d;\n  };\n\n  // Panel plane: local x runs down the slope from A, local y across the chair, extruded up.\n  const xDir = [Math.cos(a), 0, -Math.sin(a)];\n  const normal = [Math.sin(a), 0, Math.cos(a)];\n  const plane = new replicad.Plane([A[0], 0, A[1]], xDir, normal);\n\n  const half = W / 2 + T; // panels cover the runners' outside faces\n  const parts: Assembly[] = [];\n  for (const [side, s] of [[\"Right\", 1], [\"Left\", -1]] as [string, number][]) {\n    let panel = poly(s > 0 ? rect(-T, depth, gap / 2, half) : rect(-T, depth, -half, -gap / 2));\n    for (const uc of seatTabs) {\n      const u0 = uc - seatTabLen / 2 - c, u1 = uc + seatTabLen / 2 + c;\n      // Notch runs off the outside edge (overshoot 10 mm so the outer dogbones fall clear).\n      panel = panel.cut(s > 0 ? slot(u0, u1, W / 2 - c, half + 10) : slot(u0, u1, -half - 10, -W / 2 + c));\n    }\n    const solid = panel.sketchOnPlane(plane).extrude(T);\n    parts.push(new Assembly({ geometry: solid, color: wood, tags: [\"cutLayout\", \"seat\"], bom: [`${side} seat panel`] }));\n  }\n  return parts;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Seat: two wide panels resting on the runners' seat slope,\n * which runs from the runner front top A(0,380) down to the seat rear B(460,300).\n * The front of the seat overhangs to cover the apron.\n * The runner top tabs (Frame molecule, centres 110 and 350 mm along the slope, 60 long)\n * lock into dogboned notches along each panel's outside edge.\n */\nfunction run(thickness = 19.05, seatWidth = 560, bitDiameter = 6.35, clearance = 0.2, gap = 6) {\n    const T = thickness;\n    const W = seatWidth;\n    const c = clearance;\n    const r = (bitDiameter / 2) * 1.02;\n    const wood = \"#C8894F\";\n    const A = [0, 380];\n    const B = [460, 300];\n    const a = Math.atan2(A[1] - B[1], B[0] - A[0]);\n    const depth = Math.hypot(B[0] - A[0], B[1] - A[1]); // along the slope\n    const seatTabs = [110, 350];\n    const seatTabLen = 60;\n    const poly = (pts) => {\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++)\n            pen = pen.lineTo(pts[i]);\n        return pen.close();\n    };\n    const rect = (u0, u1, v0, v1) => [[u0, v0], [u1, v0], [u1, v1], [u0, v1]];\n    // Dogboned slot: bit centre r from each corner along the bisector.\n    const slot = (u0, u1, v0, v1) => {\n        let d = poly(rect(u0, u1, v0, v1));\n        const k = r / Math.SQRT2;\n        for (const [x, y, sx, sy] of [[u0, v0, 1, 1], [u1, v0, -1, 1], [u1, v1, -1, -1], [u0, v1, 1, -1]]) {\n            d = d.fuse(replicad.drawCircle(r).translate(x + sx * k, y + sy * k));\n        }\n        return d;\n    };\n    // Panel plane: local x runs down the slope from A, local y across the chair, extruded up.\n    const xDir = [Math.cos(a), 0, -Math.sin(a)];\n    const normal = [Math.sin(a), 0, Math.cos(a)];\n    const plane = new replicad.Plane([A[0], 0, A[1]], xDir, normal);\n    const half = W / 2 + T; // panels cover the runners' outside faces\n    const parts = [];\n    for (const [side, s] of [[\"Right\", 1], [\"Left\", -1]]) {\n        let panel = poly(s > 0 ? rect(-T, depth, gap / 2, half) : rect(-T, depth, -half, -gap / 2));\n        for (const uc of seatTabs) {\n            const u0 = uc - seatTabLen / 2 - c, u1 = uc + seatTabLen / 2 + c;\n            // Notch runs off the outside edge (overshoot 10 mm so the outer dogbones fall clear).\n            panel = panel.cut(s > 0 ? slot(u0, u1, W / 2 - c, half + 10) : slot(u0, u1, -half - 10, -W / 2 + c));\n        }\n        const solid = panel.sketchOnPlane(plane).extrude(T);\n        parts.push(new Assembly({ geometry: solid, color: wood, tags: [\"cutLayout\", \"seat\"], bom: [`${side} seat panel`] }));\n    }\n    return parts;\n}\n"
        },
