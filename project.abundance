          "interpreterVersion": 1,
          "code": "/**\n * Seat: two wide panels resting on the runners' seat slope,\n * which runs from the runner front top (0,380) down to the seat rear (460,300).\n * The front of the seat overhangs to cover the apron.\n */\nfunction run(thickness: number = 19.05, seatWidth: number = 560, gap: number = 6): Assembly[] {\n  const T = thickness;\n  const W = seatWidth;\n  const wood = \"#C8894F\";\n  const A = [0, 380]; // runner front top (x, z)\n  const B = [460, 300]; // runner seat rear (x, z)\n  const slopeDeg = (Math.atan2(A[1] - B[1], B[0] - A[0]) * 180) / Math.PI;\n  const depth = Math.hypot(B[0] - A[0], B[1] - A[1]); // along the slope\n\n  const half = W / 2 + T; // panels cover the runners' outside faces\n  const parts: Assembly[] = [];\n  for (const [side, y0, y1] of [[\"Right\", gap / 2, half], [\"Left\", -half, -gap / 2]] as [string, number, number][]) {\n    const panel = replicad\n      .makeBox([-T, y0, 0], [depth, y1, T])\n      .rotate(slopeDeg, [0, 0, 0], [0, 1, 0]) // tip the rear edge down\n      .translate(A[0], 0, A[1]);\n    parts.push(new Assembly({ geometry: panel, color: wood, tags: [\"cutLayout\", \"seat\"], bom: [`${side} seat panel`] }));\n  }\n  return parts;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Seat: two wide panels resting on the runners' seat slope,\n * which runs from the runner front top (0,380) down to the seat rear (460,300).\n * The front of the seat overhangs to cover the apron.\n */\nfunction run(thickness = 19.05, seatWidth = 560, gap = 6) {\n    const T = thickness;\n    const W = seatWidth;\n    const wood = \"#C8894F\";\n    const A = [0, 380]; // runner front top (x, z)\n    const B = [460, 300]; // runner seat rear (x, z)\n    const slopeDeg = (Math.atan2(A[1] - B[1], B[0] - A[0]) * 180) / Math.PI;\n    const depth = Math.hypot(B[0] - A[0], B[1] - A[1]); // along the slope\n    const half = W / 2 + T; // panels cover the runners' outside faces\n    const parts = [];\n    for (const [side, y0, y1] of [[\"Right\", gap / 2, half], [\"Left\", -half, -gap / 2]]) {\n        const panel = replicad\n            .makeBox([-T, y0, 0], [depth, y1, T])\n            .rotate(slopeDeg, [0, 0, 0], [0, 1, 0]) // tip the rear edge down\n            .translate(A[0], 0, A[1]);\n        parts.push(new Assembly({ geometry: panel, color: wood, tags: [\"cutLayout\", \"seat\"], bom: [`${side} seat panel`] }));\n    }\n    return parts;\n}\n"
        }
      ],
