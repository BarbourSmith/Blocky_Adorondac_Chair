          "interpreterVersion": 1,
          "code": "/**\n * Frame: two side runners, the front apron, and a seat stretcher, joined with through-tabs.\n * Chair axes (mm): X runs front -> back, Y across the chair, Z up.\n * Runner side profile (x, z): front top A(0,380) -> seat rear B(460,300) -> toe (960,0)\n * -> heel (720,0) -> front bottom (0,200). A->B is the seat slope.\n *\n * Joints owned here:\n *  - runner front tab -> slot in the apron\n *  - runner top tabs -> notches in the seat panels (Seat molecule, same positions)\n *  - seat stretcher end tabs -> slots in the runners\n *  - slots in the runners for the lower back batten tabs (Back molecule, same geometry)\n * Slots are grown by clearance and dogboned for the bit so square tabs seat fully.\n */\nfunction run(\n  thickness: number = 19.05,\n  seatWidth: number = 560,\n  backAngle: number = 24,\n  bitDiameter: number = 6.35,\n  clearance: number = 0.2,\n): Assembly[] {\n  const T = thickness;\n  const W = seatWidth;\n  const c = clearance;\n  const r = (bitDiameter / 2) * 1.02;\n  const wood = \"#C8894F\";\n\n  const A = [0, 380];\n  const B = [460, 300];\n  const a = Math.atan2(A[1] - B[1], B[0] - A[0]);\n  const tHat = [Math.cos(a), -Math.sin(a)]; // down the seat slope\n  const mHat = [Math.sin(a), Math.cos(a)]; // up out of the seat slope\n  const b = (backAngle * Math.PI) / 180;\n  const seatTabs = [110, 350]; // tab centres along the seat slope from A\n  const seatTabLen = 60;\n  const SX = 360; // seat stretcher front face\n  const apronTab = [260, 320]; // runner front tab z range\n  const stretcherTab = [250, 290]; // seat stretcher tab z range\n\n  const add = (p: number[], q: number[], k = 1) => [p[0] + k * q[0], p[1] + k * q[1]];\n  const poly = (pts: number[][]) => {\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n    return pen.close();\n  };\n  // A four-corner slot with a dogbone at each corner: the bit centre sits r from the corner\n  // along the bisector, so it reaches right into the corner.\n  const slot = (pts: number[][]) => {\n    let d = poly(pts);\n    for (let i = 0; i < 4; i++) {\n      const p = pts[i], n = pts[(i + 1) % 4], q = pts[(i + 3) % 4];\n      const e1 = [n[0] - p[0], n[1] - p[1]], e2 = [q[0] - p[0], q[1] - p[1]];\n      const l1 = Math.hypot(e1[0], e1[1]), l2 = Math.hypot(e2[0], e2[1]);\n      const bis = [e1[0] / l1 + e2[0] / l2, e1[1] / l1 + e2[1] / l2];\n      const lb = Math.hypot(bis[0], bis[1]);\n      d = d.fuse(replicad.drawCircle(r).translate(p[0] + (r * bis[0]) / lb, p[1] + (r * bis[1]) / lb));\n    }\n    return d;\n  };\n  const rect = (u0: number, u1: number, v0: number, v1: number, map = (u: number, v: number) => [u, v]) =>\n    [map(u0, v0), map(u1, v0), map(u1, v1), map(u0, v1)];\n  // Extrude a drawing T thick on a plane whose local x/y map to world xDir/yDir.\n  const sheet = (d: any, origin: number[], xDir: number[], yDir: number[]) => {\n    const n = [\n      xDir[1] * yDir[2] - xDir[2] * yDir[1],\n      xDir[2] * yDir[0] - xDir[0] * yDir[2],\n      xDir[0] * yDir[1] - xDir[1] * yDir[0],\n    ];\n    return d.sketchOnPlane(new replicad.Plane(origin, xDir, n)).extrude(T);\n  };\n  // Side-view (XZ) board occupying y0 .. y0+T.\n  const sideSheet = (d: any, y0: number) => sheet(d, [0, y0 + T, 0], [1, 0, 0], [0, 0, 1]);\n  // Across-the-chair (YZ) board occupying x0 .. x0+T.\n  const crossSheet = (d: any, x0: number) => sheet(d, [x0, 0, 0], [0, 1, 0], [0, 0, 1]);\n\n  // ---- Runner profile with tabs ----\n  const outline: number[][] = [A];\n  for (const uc of seatTabs) {\n    const p0 = add(A, tHat, uc - seatTabLen / 2);\n    const p3 = add(A, tHat, uc + seatTabLen / 2);\n    outline.push(p0, add(p0, mHat, T), add(p3, mHat, T), p3);\n  }\n  outline.push(B, [960, 0], [720, 0], [0, 200], [0, apronTab[0]], [-T, apronTab[0]], [-T, apronTab[1]], [0, apronTab[1]]);\n  let runner = poly(outline);\n  // Seat stretcher tab slot.\n  runner = runner.cut(slot(rect(SX - c, SX + T + c, stretcherTab[0] - c, stretcherTab[1] + c)));\n  // Lower back batten tab slot: back-local (lx across the back, lz along it) leaned about the seat rear.\n  const backMap = (lx: number, lz: number) => [\n    B[0] + lx * Math.cos(b) + lz * Math.sin(b),\n    B[1] - lx * Math.sin(b) + lz * Math.cos(b),\n  ];\n  runner = runner.cut(slot(rect(T - c, 2 * T + c, -70 - c, -20 + c, backMap)));\n\n  const parts: Assembly[] = [];\n  for (const [side, y0] of [[\"Right\", W / 2], [\"Left\", -W / 2 - T]] as [string, number][]) {\n    parts.push(new Assembly({ geometry: sideSheet(runner, y0), color: wood, tags: [\"cutLayout\", \"runner\"], bom: [`${side} runner`] }));\n  }\n\n  // ---- Apron: caps the runner fronts, runner tabs pass through it ----\n  const apronHalf = W / 2 + T + 20;\n  let apron = poly(rect(-apronHalf, apronHalf, 200, 380));\n  for (const s of [1, -1]) {\n    const y0 = s > 0 ? W / 2 - c : -W / 2 - T - c;\n    apron = apron.cut(slot(rect(y0, y0 + T + 2 * c, apronTab[0] - c, apronTab[1] + c)));\n  }\n  parts.push(new Assembly({ geometry: crossSheet(apron, -T), color: wood, tags: [\"cutLayout\", \"apron\"], bom: [\"Front apron\"] }));\n\n  // ---- Seat stretcher: supports the inner edges of the seat panels at the rear ----\n  const top = A[1] - (SX + T) * Math.tan(a) - 0.5; // just under the sloped seat\n  const h = W / 2;\n  const stretcher = poly([\n    [-h, 230], [h, 230], [h, stretcherTab[0]], [h + T, stretcherTab[0]], [h + T, stretcherTab[1]], [h, stretcherTab[1]],\n    [h, top], [-h, top], [-h, stretcherTab[1]], [-h - T, stretcherTab[1]], [-h - T, stretcherTab[0]], [-h, stretcherTab[0]],\n  ]);\n  parts.push(new Assembly({ geometry: crossSheet(stretcher, SX), color: wood, tags: [\"cutLayout\", \"stretcher\"], bom: [\"Seat stretcher\"] }));\n  return parts;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Frame: two side runners, the front apron, and a seat stretcher, joined with through-tabs.\n * Chair axes (mm): X runs front -> back, Y across the chair, Z up.\n * Runner side profile (x, z): front top A(0,380) -> seat rear B(460,300) -> toe (960,0)\n * -> heel (720,0) -> front bottom (0,200). A->B is the seat slope.\n *\n * Joints owned here:\n *  - runner front tab -> slot in the apron\n *  - runner top tabs -> notches in the seat panels (Seat molecule, same positions)\n *  - seat stretcher end tabs -> slots in the runners\n *  - slots in the runners for the lower back batten tabs (Back molecule, same geometry)\n * Slots are grown by clearance and dogboned for the bit so square tabs seat fully.\n */\nfunction run(thickness = 19.05, seatWidth = 560, backAngle = 24, bitDiameter = 6.35, clearance = 0.2) {\n    const T = thickness;\n    const W = seatWidth;\n    const c = clearance;\n    const r = (bitDiameter / 2) * 1.02;\n    const wood = \"#C8894F\";\n    const A = [0, 380];\n    const B = [460, 300];\n    const a = Math.atan2(A[1] - B[1], B[0] - A[0]);\n    const tHat = [Math.cos(a), -Math.sin(a)]; // down the seat slope\n    const mHat = [Math.sin(a), Math.cos(a)]; // up out of the seat slope\n    const b = (backAngle * Math.PI) / 180;\n    const seatTabs = [110, 350]; // tab centres along the seat slope from A\n    const seatTabLen = 60;\n    const SX = 360; // seat stretcher front face\n    const apronTab = [260, 320]; // runner front tab z range\n    const stretcherTab = [250, 290]; // seat stretcher tab z range\n    const add = (p, q, k = 1) => [p[0] + k * q[0], p[1] + k * q[1]];\n    const poly = (pts) => {\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++)\n            pen = pen.lineTo(pts[i]);\n        return pen.close();\n    };\n    // A four-corner slot with a dogbone at each corner: the bit centre sits r from the corner\n    // along the bisector, so it reaches right into the corner.\n    const slot = (pts) => {\n        let d = poly(pts);\n        for (let i = 0; i < 4; i++) {\n            const p = pts[i], n = pts[(i + 1) % 4], q = pts[(i + 3) % 4];\n            const e1 = [n[0] - p[0], n[1] - p[1]], e2 = [q[0] - p[0], q[1] - p[1]];\n            const l1 = Math.hypot(e1[0], e1[1]), l2 = Math.hypot(e2[0], e2[1]);\n            const bis = [e1[0] / l1 + e2[0] / l2, e1[1] / l1 + e2[1] / l2];\n            const lb = Math.hypot(bis[0], bis[1]);\n            d = d.fuse(replicad.drawCircle(r).translate(p[0] + (r * bis[0]) / lb, p[1] + (r * bis[1]) / lb));\n        }\n        return d;\n    };\n    const rect = (u0, u1, v0, v1, map = (u, v) => [u, v]) => [map(u0, v0), map(u1, v0), map(u1, v1), map(u0, v1)];\n    // Extrude a drawing T thick on a plane whose local x/y map to world xDir/yDir.\n    const sheet = (d, origin, xDir, yDir) => {\n        const n = [\n            xDir[1] * yDir[2] - xDir[2] * yDir[1],\n            xDir[2] * yDir[0] - xDir[0] * yDir[2],\n            xDir[0] * yDir[1] - xDir[1] * yDir[0],\n        ];\n        return d.sketchOnPlane(new replicad.Plane(origin, xDir, n)).extrude(T);\n    };\n    // Side-view (XZ) board occupying y0 .. y0+T.\n    const sideSheet = (d, y0) => sheet(d, [0, y0 + T, 0], [1, 0, 0], [0, 0, 1]);\n    // Across-the-chair (YZ) board occupying x0 .. x0+T.\n    const crossSheet = (d, x0) => sheet(d, [x0, 0, 0], [0, 1, 0], [0, 0, 1]);\n    // ---- Runner profile with tabs ----\n    const outline = [A];\n    for (const uc of seatTabs) {\n        const p0 = add(A, tHat, uc - seatTabLen / 2);\n        const p3 = add(A, tHat, uc + seatTabLen / 2);\n        outline.push(p0, add(p0, mHat, T), add(p3, mHat, T), p3);\n    }\n    outline.push(B, [960, 0], [720, 0], [0, 200], [0, apronTab[0]], [-T, apronTab[0]], [-T, apronTab[1]], [0, apronTab[1]]);\n    let runner = poly(outline);\n    // Seat stretcher tab slot.\n    runner = runner.cut(slot(rect(SX - c, SX + T + c, stretcherTab[0] - c, stretcherTab[1] + c)));\n    // Lower back batten tab slot: back-local (lx across the back, lz along it) leaned about the seat rear.\n    const backMap = (lx, lz) => [\n        B[0] + lx * Math.cos(b) + lz * Math.sin(b),\n        B[1] - lx * Math.sin(b) + lz * Math.cos(b),\n    ];\n    runner = runner.cut(slot(rect(T - c, 2 * T + c, -70 - c, -20 + c, backMap)));\n    const parts = [];\n    for (const [side, y0] of [[\"Right\", W / 2], [\"Left\", -W / 2 - T]]) {\n        parts.push(new Assembly({ geometry: sideSheet(runner, y0), color: wood, tags: [\"cutLayout\", \"runner\"], bom: [`${side} runner`] }));\n    }\n    // ---- Apron: caps the runner fronts, runner tabs pass through it ----\n    const apronHalf = W / 2 + T + 20;\n    let apron = poly(rect(-apronHalf, apronHalf, 200, 380));\n    for (const s of [1, -1]) {\n        const y0 = s > 0 ? W / 2 - c : -W / 2 - T - c;\n        apron = apron.cut(slot(rect(y0, y0 + T + 2 * c, apronTab[0] - c, apronTab[1] + c)));\n    }\n    parts.push(new Assembly({ geometry: crossSheet(apron, -T), color: wood, tags: [\"cutLayout\", \"apron\"], bom: [\"Front apron\"] }));\n    // ---- Seat stretcher: supports the inner edges of the seat panels at the rear ----\n    const top = A[1] - (SX + T) * Math.tan(a) - 0.5; // just under the sloped seat\n    const h = W / 2;\n    const stretcher = poly([\n        [-h, 230], [h, 230], [h, stretcherTab[0]], [h + T, stretcherTab[0]], [h + T, stretcherTab[1]], [h, stretcherTab[1]],\n        [h, top], [-h, top], [-h, stretcherTab[1]], [-h - T, stretcherTab[1]], [-h - T, stretcherTab[0]], [-h, stretcherTab[0]],\n    ]);\n    parts.push(new Assembly({ geometry: crossSheet(stretcher, SX), color: wood, tags: [\"cutLayout\", \"stretcher\"], bom: [\"Seat stretcher\"] }));\n    return parts;\n}\n"
        },
