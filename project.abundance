          "interpreterVersion": 1,
          "code": "/**\n * Frame: two side runners plus the front apron.\n * Chair axes (mm): X runs front -> back, Y across the chair, Z up.\n * Runner side profile corners (x, z):\n *   front top (0,380) -> seat rear (460,300) -> toe (960,0) -> heel (720,0) -> front bottom (0,200)\n * The top edge from front to seat rear is the seat slope; the seat panels sit on it.\n */\nfunction run(thickness: number = 19.05, seatWidth: number = 560): Assembly[] {\n  const T = thickness;\n  const W = seatWidth; // clear width between the runners\n  const wood = \"#C8894F\";\n\n  // A flat board cut from a profile drawn in the side (XZ) view, placed with its\n  // inner face at y = y0 and extending T in +Y.\n  const sideBoard = (pts: number[][], y0: number) => {\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n    let solid = pen.close().sketchOnPlane(\"XZ\").extrude(T);\n    const bb = solid.boundingBox.bounds;\n    return solid.translate(0, y0 - bb[0][1], 0);\n  };\n\n  const runnerPts = [[0, 380], [0, 200], [720, 0], [960, 0], [460, 300]];\n  const parts: Assembly[] = [];\n  for (const [side, y0] of [[\"Right\", W / 2], [\"Left\", -W / 2 - T]] as [string, number][]) {\n    parts.push(new Assembly({\n      geometry: sideBoard(runnerPts, y0),\n      color: wood,\n      tags: [\"cutLayout\", \"runner\"],\n      bom: [`${side} runner`],\n    }));\n  }\n\n  // Front apron: spans the outside faces of both runners and caps their front ends.\n  const apron = replicad.makeBox([-T, -(W / 2 + T), 200], [0, W / 2 + T, 380]);\n  parts.push(new Assembly({ geometry: apron, color: wood, tags: [\"cutLayout\", \"apron\"], bom: [\"Front apron\"] }));\n  return parts;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Frame: two side runners plus the front apron.\n * Chair axes (mm): X runs front -> back, Y across the chair, Z up.\n * Runner side profile corners (x, z):\n *   front top (0,380) -> seat rear (460,300) -> toe (960,0) -> heel (720,0) -> front bottom (0,200)\n * The top edge from front to seat rear is the seat slope; the seat panels sit on it.\n */\nfunction run(thickness = 19.05, seatWidth = 560) {\n    const T = thickness;\n    const W = seatWidth; // clear width between the runners\n    const wood = \"#C8894F\";\n    // A flat board cut from a profile drawn in the side (XZ) view, placed with its\n    // inner face at y = y0 and extending T in +Y.\n    const sideBoard = (pts, y0) => {\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++)\n            pen = pen.lineTo(pts[i]);\n        let solid = pen.close().sketchOnPlane(\"XZ\").extrude(T);\n        const bb = solid.boundingBox.bounds;\n        return solid.translate(0, y0 - bb[0][1], 0);\n    };\n    const runnerPts = [[0, 380], [0, 200], [720, 0], [960, 0], [460, 300]];\n    const parts = [];\n    for (const [side, y0] of [[\"Right\", W / 2], [\"Left\", -W / 2 - T]]) {\n        parts.push(new Assembly({\n            geometry: sideBoard(runnerPts, y0),\n            color: wood,\n            tags: [\"cutLayout\", \"runner\"],\n            bom: [`${side} runner`],\n        }));\n    }\n    // Front apron: spans the outside faces of both runners and caps their front ends.\n    const apron = replicad.makeBox([-T, -(W / 2 + T), 200], [0, W / 2 + T, 380]);\n    parts.push(new Assembly({ geometry: apron, color: wood, tags: [\"cutLayout\", \"apron\"], bom: [\"Front apron\"] }));\n    return parts;\n}\n"
        }
