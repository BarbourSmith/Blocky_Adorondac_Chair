          ],
          "interpreterVersion": 1,
          "code": "/**\n * Arms and legs: swept-back front legs with a triangular gusset under each arm,\n * rear arm posts, an upper back batten, and two arms, locked together with through-tabs.\n * The back's rear face crosses arm height at xBack; the batten sits just behind it on\n * top of the rear posts, and the arms rest on the front legs and the batten.\n * Back pivot matches the Back molecule: seat rear bottom edge at (460, 300).\n * armHeight is the top of the arms above the floor.\n * legSweep is how far the front legs lean back from vertical (degrees).\n * The gusset stands at 90 degrees to the leg: it is centred on the leg's width, leans with\n * the sweep, runs out under the arm's overhang, and tapers to a point gussetLength down the leg.\n *\n * Joints owned here:\n *  - front leg top tab -> slot through the arm\n *  - rear post top tab -> slots through the upper batten and the arm\n *  - gusset edge tabs -> slots through the front leg\n */\nfunction run(\n  thickness: number = 19.05,\n  seatWidth: number = 560,\n  backAngle: number = 24,\n  armHeight: number = 600,\n  legSweep: number = 20,\n  bitDiameter: number = 6.35,\n  clearance: number = 0.2,\n  armWidth: number = 120,\n  gussetLength: number = 300,\n): Assembly[] {\n  const T = thickness;\n  const W = seatWidth;\n  const H = armHeight;\n  const c = clearance;\n  const r = (bitDiameter / 2) * 1.02;\n  const wood = \"#C8894F\";\n  const P = [460, 300];\n  const b = (backAngle * Math.PI) / 180;\n  const s = (legSweep * Math.PI) / 180;\n\n  // Rear face of the back where it meets the underside of the arms, plus 1 mm clearance.\n  const xBack = P[0] + T * Math.cos(b) + (H - T - (P[1] - T * Math.sin(b))) * Math.tan(b) + 1;\n  const postDepth = 100;\n  const armFront = -60;\n  const armRear = xBack + postDepth;\n  const armIn = W / 2 + 5; // clears the back panels\n  const armOut = armIn + armWidth;\n  const tabLen = 50; // tabs through the arms and batten\n  const bandIn = W / 2 + T; // legs and posts sit outboard of the runners\n  const bandOut = W / 2 + 2 * T;\n\n  const poly = (pts: number[][]) => {\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n    return pen.close();\n  };\n  // Dogboned slot through four corners (any orientation): bit centre r from each corner along the bisector.\n  const slot = (pts: number[][]) => {\n    let d = poly(pts);\n    for (let i = 0; i < 4; i++) {\n      const p = pts[i], n = pts[(i + 1) % 4], q = pts[(i + 3) % 4];\n      const e1 = [n[0] - p[0], n[1] - p[1]], e2 = [q[0] - p[0], q[1] - p[1]];\n      const l1 = Math.hypot(e1[0], e1[1]), l2 = Math.hypot(e2[0], e2[1]);\n      const bis = [e1[0] / l1 + e2[0] / l2, e1[1] / l1 + e2[1] / l2];\n      const lb = Math.hypot(bis[0], bis[1]);\n      d = d.fuse(replicad.drawCircle(r).translate(p[0] + (r * bis[0]) / lb, p[1] + (r * bis[1]) / lb));\n    }\n    return d;\n  };\n  const rect = (u0: number, u1: number, v0: number, v1: number, map = (u: number, v: number) => [u, v]) =>\n    [map(u0, v0), map(u1, v0), map(u1, v1), map(u0, v1)];\n  // Side-view (XZ) board occupying y0 .. y0+T.\n  const sideSheet = (d: any, y0: number) =>\n    d.sketchOnPlane(new replicad.Plane([0, y0 + T, 0], [1, 0, 0], [0, -1, 0])).extrude(T);\n  // Flat (XY) board occupying z0 .. z0+T.\n  const flatSheet = (d: any, z0: number) => d.sketchOnPlane(\"XY\").extrude(T).translate(0, 0, z0);\n\n  // ---- Front leg: 90 mm wide, swept back by legSweep, cut level at the floor and under the arm ----\n  const legWidth = 90;\n  const legFoot = -40; // front of the foot, ahead of the seat front\n  const wFlat = legWidth / Math.cos(s);\n  const rise = H - T;\n  const TL = [legFoot + rise * Math.tan(s), rise];\n  const TR = [TL[0] + wFlat, rise];\n  const legMid = (TL[0] + TR[0]) / 2;\n  // Leg-local frame: u across the leg from its front edge, v up along the sweep.\n  const legMap = (u: number, v: number) => [legFoot + v * Math.sin(s) + u * Math.cos(s), v * Math.cos(s) - u * Math.sin(s)];\n\n  // Gusset position in leg-local coordinates: centred on the leg width, top face under the arm.\n  const gU0 = (legWidth - T) / 2;\n  const gTop = (rise + gU0 * Math.sin(s)) / Math.cos(s); // v where the gusset's front face meets the arm\n  const gTip = gTop - gussetLength;\n  const gTabs = [[gTop - 110, gTop - 50], [gTop - 230, gTop - 180]]; // v ranges of the edge tabs\n\n  let leg = poly([\n    [legFoot, 0], [legFoot + wFlat, 0], TR,\n    [legMid + tabLen / 2, rise], [legMid + tabLen / 2, H], [legMid - tabLen / 2, H], [legMid - tabLen / 2, rise],\n    TL,\n  ]);\n  for (const [v0, v1] of gTabs) leg = leg.cut(slot(rect(gU0 - c, gU0 + T + c, v0 - c, v1 + c, legMap)));\n\n  // Gusset outline in the (y, v) plane for the right side; the left side mirrors y.\n  const gOut = armOut - 5;\n  const gussetDrawing = (sign: number) => {\n    const pts: number[][] = [[bandOut, gTip], [gOut, gTop], [bandOut, gTop]];\n    // Edge tabs reach back through the leg (bandIn .. bandOut).\n    for (const [v0, v1] of gTabs) pts.push([bandOut, v1], [bandIn, v1], [bandIn, v0], [bandOut, v0]);\n    return poly(pts.map(([y, v]) => [sign * y, v]));\n  };\n  const gussetSolid = (sign: number) =>\n    gussetDrawing(sign)\n      .sketchOnPlane(new replicad.Plane([gU0, 0, 0], [0, 1, 0], [1, 0, 0])) // local x -> y, local y -> v, extrude +u\n      .extrude(T)\n      .rotate(legSweep, [0, 0, 0], [0, 1, 0]) // u -> across the leg, v -> up the sweep\n      .translate(legFoot, 0, 0);\n\n  // ---- Rear post: carries the upper batten, tab runs up through batten and arm ----\n  const postMid = xBack + postDepth / 2;\n  const post = poly([\n    [xBack, 0], [xBack + postDepth, 0], [xBack + postDepth, H - 2 * T],\n    [postMid + tabLen / 2, H - 2 * T], [postMid + tabLen / 2, H], [postMid - tabLen / 2, H], [postMid - tabLen / 2, H - 2 * T],\n    [xBack, H - 2 * T],\n  ]);\n\n  // Slot footprints (plan view) for the leg and post tabs on one side.\n  const tabSlots = (sign: number) => {\n    const y0 = sign > 0 ? bandIn - c : -bandOut - c;\n    const y1 = y0 + T + 2 * c;\n    return [\n      slot(rect(legMid - tabLen / 2 - c, legMid + tabLen / 2 + c, y0, y1)),\n      slot(rect(postMid - tabLen / 2 - c, postMid + tabLen / 2 + c, y0, y1)),\n    ];\n  };\n\n  const parts: Assembly[] = [];\n  const armLen = armRear - armFront;\n  for (const [side, sign] of [[\"Right\", 1], [\"Left\", -1]] as [string, number][]) {\n    const y0 = sign > 0 ? bandIn : -bandOut;\n    parts.push(new Assembly({ geometry: sideSheet(leg, y0), color: wood, tags: [\"cutLayout\", \"leg\"], bom: [`${side} front leg`] }));\n    parts.push(new Assembly({ geometry: gussetSolid(sign), color: wood, tags: [\"cutLayout\", \"gusset\"], bom: [`${side} arm gusset`] }));\n    parts.push(new Assembly({ geometry: sideSheet(post, y0), color: wood, tags: [\"cutLayout\", \"post\"], bom: [`${side} rear post`] }));\n\n    // Arm: square rear, rounded front corners, slots for the leg and post tabs.\n    let arm = replicad\n      .drawRoundedRectangle(armLen, armWidth, 45)\n      .fuse(replicad.drawRectangle(armLen / 2, armWidth).translate(armLen / 4, 0))\n      .translate((armFront + armRear) / 2, (sign * (armIn + armOut)) / 2);\n    for (const sl of tabSlots(sign)) arm = arm.cut(sl);\n    parts.push(new Assembly({ geometry: flatSheet(arm, H - T), color: wood, tags: [\"cutLayout\", \"arm\"], bom: [`${side} arm`] }));\n  }\n\n  // ---- Upper back batten: spans under both arms, sits on the rear posts ----\n  let batten = poly(rect(xBack, armRear, -armOut, armOut));\n  for (const sign of [1, -1]) batten = batten.cut(tabSlots(sign)[1]);\n  parts.push(new Assembly({ geometry: flatSheet(batten, H - 2 * T), color: wood, tags: [\"cutLayout\", \"batten\"], bom: [\"Upper back batten\"] }));\n  return parts;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Arms and legs: swept-back front legs with a triangular gusset under each arm,\n * rear arm posts, an upper back batten, and two arms, locked together with through-tabs.\n * The back's rear face crosses arm height at xBack; the batten sits just behind it on\n * top of the rear posts, and the arms rest on the front legs and the batten.\n * Back pivot matches the Back molecule: seat rear bottom edge at (460, 300).\n * armHeight is the top of the arms above the floor.\n * legSweep is how far the front legs lean back from vertical (degrees).\n * The gusset stands at 90 degrees to the leg: it is centred on the leg's width, leans with\n * the sweep, runs out under the arm's overhang, and tapers to a point gussetLength down the leg.\n *\n * Joints owned here:\n *  - front leg top tab -> slot through the arm\n *  - rear post top tab -> slots through the upper batten and the arm\n *  - gusset edge tabs -> slots through the front leg\n */\nfunction run(thickness = 19.05, seatWidth = 560, backAngle = 24, armHeight = 600, legSweep = 20, bitDiameter = 6.35, clearance = 0.2, armWidth = 120, gussetLength = 300) {\n    const T = thickness;\n    const W = seatWidth;\n    const H = armHeight;\n    const c = clearance;\n    const r = (bitDiameter / 2) * 1.02;\n    const wood = \"#C8894F\";\n    const P = [460, 300];\n    const b = (backAngle * Math.PI) / 180;\n    const s = (legSweep * Math.PI) / 180;\n    // Rear face of the back where it meets the underside of the arms, plus 1 mm clearance.\n    const xBack = P[0] + T * Math.cos(b) + (H - T - (P[1] - T * Math.sin(b))) * Math.tan(b) + 1;\n    const postDepth = 100;\n    const armFront = -60;\n    const armRear = xBack + postDepth;\n    const armIn = W / 2 + 5; // clears the back panels\n    const armOut = armIn + armWidth;\n    const tabLen = 50; // tabs through the arms and batten\n    const bandIn = W / 2 + T; // legs and posts sit outboard of the runners\n    const bandOut = W / 2 + 2 * T;\n    const poly = (pts) => {\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++)\n            pen = pen.lineTo(pts[i]);\n        return pen.close();\n    };\n    // Dogboned slot through four corners (any orientation): bit centre r from each corner along the bisector.\n    const slot = (pts) => {\n        let d = poly(pts);\n        for (let i = 0; i < 4; i++) {\n            const p = pts[i], n = pts[(i + 1) % 4], q = pts[(i + 3) % 4];\n            const e1 = [n[0] - p[0], n[1] - p[1]], e2 = [q[0] - p[0], q[1] - p[1]];\n            const l1 = Math.hypot(e1[0], e1[1]), l2 = Math.hypot(e2[0], e2[1]);\n            const bis = [e1[0] / l1 + e2[0] / l2, e1[1] / l1 + e2[1] / l2];\n            const lb = Math.hypot(bis[0], bis[1]);\n            d = d.fuse(replicad.drawCircle(r).translate(p[0] + (r * bis[0]) / lb, p[1] + (r * bis[1]) / lb));\n        }\n        return d;\n    };\n    const rect = (u0, u1, v0, v1, map = (u, v) => [u, v]) => [map(u0, v0), map(u1, v0), map(u1, v1), map(u0, v1)];\n    // Side-view (XZ) board occupying y0 .. y0+T.\n    const sideSheet = (d, y0) => d.sketchOnPlane(new replicad.Plane([0, y0 + T, 0], [1, 0, 0], [0, -1, 0])).extrude(T);\n    // Flat (XY) board occupying z0 .. z0+T.\n    const flatSheet = (d, z0) => d.sketchOnPlane(\"XY\").extrude(T).translate(0, 0, z0);\n    // ---- Front leg: 90 mm wide, swept back by legSweep, cut level at the floor and under the arm ----\n    const legWidth = 90;\n    const legFoot = -40; // front of the foot, ahead of the seat front\n    const wFlat = legWidth / Math.cos(s);\n    const rise = H - T;\n    const TL = [legFoot + rise * Math.tan(s), rise];\n    const TR = [TL[0] + wFlat, rise];\n    const legMid = (TL[0] + TR[0]) / 2;\n    // Leg-local frame: u across the leg from its front edge, v up along the sweep.\n    const legMap = (u, v) => [legFoot + v * Math.sin(s) + u * Math.cos(s), v * Math.cos(s) - u * Math.sin(s)];\n    // Gusset position in leg-local coordinates: centred on the leg width, top face under the arm.\n    const gU0 = (legWidth - T) / 2;\n    const gTop = (rise + gU0 * Math.sin(s)) / Math.cos(s); // v where the gusset's front face meets the arm\n    const gTip = gTop - gussetLength;\n    const gTabs = [[gTop - 110, gTop - 50], [gTop - 230, gTop - 180]]; // v ranges of the edge tabs\n    let leg = poly([\n        [legFoot, 0], [legFoot + wFlat, 0], TR,\n        [legMid + tabLen / 2, rise], [legMid + tabLen / 2, H], [legMid - tabLen / 2, H], [legMid - tabLen / 2, rise],\n        TL,\n    ]);\n    for (const [v0, v1] of gTabs)\n        leg = leg.cut(slot(rect(gU0 - c, gU0 + T + c, v0 - c, v1 + c, legMap)));\n    // Gusset outline in the (y, v) plane for the right side; the left side mirrors y.\n    const gOut = armOut - 5;\n    const gussetDrawing = (sign) => {\n        const pts = [[bandOut, gTip], [gOut, gTop], [bandOut, gTop]];\n        // Edge tabs reach back through the leg (bandIn .. bandOut).\n        for (const [v0, v1] of gTabs)\n            pts.push([bandOut, v1], [bandIn, v1], [bandIn, v0], [bandOut, v0]);\n        return poly(pts.map(([y, v]) => [sign * y, v]));\n    };\n    const gussetSolid = (sign) => gussetDrawing(sign)\n        .sketchOnPlane(new replicad.Plane([gU0, 0, 0], [0, 1, 0], [1, 0, 0])) // local x -> y, local y -> v, extrude +u\n        .extrude(T)\n        .rotate(legSweep, [0, 0, 0], [0, 1, 0]) // u -> across the leg, v -> up the sweep\n        .translate(legFoot, 0, 0);\n    // ---- Rear post: carries the upper batten, tab runs up through batten and arm ----\n    const postMid = xBack + postDepth / 2;\n    const post = poly([\n        [xBack, 0], [xBack + postDepth, 0], [xBack + postDepth, H - 2 * T],\n        [postMid + tabLen / 2, H - 2 * T], [postMid + tabLen / 2, H], [postMid - tabLen / 2, H], [postMid - tabLen / 2, H - 2 * T],\n        [xBack, H - 2 * T],\n    ]);\n    // Slot footprints (plan view) for the leg and post tabs on one side.\n    const tabSlots = (sign) => {\n        const y0 = sign > 0 ? bandIn - c : -bandOut - c;\n        const y1 = y0 + T + 2 * c;\n        return [\n            slot(rect(legMid - tabLen / 2 - c, legMid + tabLen / 2 + c, y0, y1)),\n            slot(rect(postMid - tabLen / 2 - c, postMid + tabLen / 2 + c, y0, y1)),\n        ];\n    };\n    const parts = [];\n    const armLen = armRear - armFront;\n    for (const [side, sign] of [[\"Right\", 1], [\"Left\", -1]]) {\n        const y0 = sign > 0 ? bandIn : -bandOut;\n        parts.push(new Assembly({ geometry: sideSheet(leg, y0), color: wood, tags: [\"cutLayout\", \"leg\"], bom: [`${side} front leg`] }));\n        parts.push(new Assembly({ geometry: gussetSolid(sign), color: wood, tags: [\"cutLayout\", \"gusset\"], bom: [`${side} arm gusset`] }));\n        parts.push(new Assembly({ geometry: sideSheet(post, y0), color: wood, tags: [\"cutLayout\", \"post\"], bom: [`${side} rear post`] }));\n        // Arm: square rear, rounded front corners, slots for the leg and post tabs.\n        let arm = replicad\n            .drawRoundedRectangle(armLen, armWidth, 45)\n            .fuse(replicad.drawRectangle(armLen / 2, armWidth).translate(armLen / 4, 0))\n            .translate((armFront + armRear) / 2, (sign * (armIn + armOut)) / 2);\n        for (const sl of tabSlots(sign))\n            arm = arm.cut(sl);\n        parts.push(new Assembly({ geometry: flatSheet(arm, H - T), color: wood, tags: [\"cutLayout\", \"arm\"], bom: [`${side} arm`] }));\n    }\n    // ---- Upper back batten: spans under both arms, sits on the rear posts ----\n    let batten = poly(rect(xBack, armRear, -armOut, armOut));\n    for (const sign of [1, -1])\n        batten = batten.cut(tabSlots(sign)[1]);\n    parts.push(new Assembly({ geometry: flatSheet(batten, H - 2 * T), color: wood, tags: [\"cutLayout\", \"batten\"], bom: [\"Upper back batten\"] }));\n    return parts;\n}\n"
        },
