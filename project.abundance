        },
        {
          "atomType": "Code",
          "x": 0.5,
          "y": 0.5,
          "uniqueID": "id-8386",
          "ioValues": [
            {
              "name": "thickness",
              "ioValue": 19.05
            },
            {
              "name": "seatWidth",
              "ioValue": 560
