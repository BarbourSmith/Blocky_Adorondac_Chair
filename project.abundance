          ],
          "interpreterVersion": 1,
          "code": "/**\n * Arms and legs: swept-back front legs, rear arm posts, an upper back batten, and two arms.\n * The back's rear face crosses arm height at xBack; the batten sits just behind it on\n * top of the rear posts, and the arms rest on the front legs and the batten.\n * Back pivot matches the Back molecule: seat rear bottom edge at (460, 300).\n * armHeight is the top of the arms above the floor.\n * legSweep is how far the front legs lean back from vertical (degrees); the foot sits\n * forward of the seat and the top lands well back under the arm.\n */\nfunction run(\n  thickness: number = 19.05,\n  seatWidth: number = 560,\n  backAngle: number = 24,\n  armHeight: number = 600,\n  legSweep: number = 20,\n  armWidth: number = 120,\n): Assembly[] {\n  const T = thickness;\n  const W = seatWidth;\n  const H = armHeight;\n  const wood = \"#C8894F\";\n  const P = [460, 300];\n  const b = (backAngle * Math.PI) / 180;\n  const s = (legSweep * Math.PI) / 180;\n\n  // Rear face of the back where it meets the underside of the arms, plus 1 mm clearance.\n  const xBack = P[0] + T * Math.cos(b) + (H - T - (P[1] - T * Math.sin(b))) * Math.tan(b) + 1;\n  const postDepth = 100;\n  const armFront = -60;\n  const armRear = xBack + postDepth;\n  const armIn = W / 2 + 5; // clears the back panels\n  const armOut = armIn + armWidth;\n\n  // Board drawn in the side (XZ) view with its inner face at y0.\n  const sideBoard = (pts: number[][], y0: number) => {\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n    const solid = pen.close().sketchOnPlane(\"XZ\").extrude(T);\n    const bb = solid.boundingBox.bounds;\n    return solid.translate(0, y0 - bb[0][1], 0);\n  };\n\n  // Front leg: a 90 mm wide board swept back by legSweep, cut level at the floor and under the arm.\n  const legWidth = 90;\n  const legFoot = -40; // front of the foot, ahead of the seat front\n  const wFlat = legWidth / Math.cos(s); // width measured along the level cuts\n  const rise = H - T;\n  const run_ = rise * Math.tan(s);\n  const legPts = [[legFoot, 0], [legFoot + wFlat, 0], [legFoot + wFlat + run_, rise], [legFoot + run_, rise]];\n  const postPts = [[xBack, 0], [xBack + postDepth, 0], [xBack + postDepth, H - 2 * T], [xBack, H - 2 * T]];\n\n  // Arm outline in plan: square rear, rounded front corners.\n  const armLen = armRear - armFront;\n  const armDrawing = replicad\n    .drawRoundedRectangle(armLen, armWidth, 45)\n    .fuse(replicad.drawRectangle(armLen / 2, armWidth).translate(armLen / 4, 0));\n\n  const parts: Assembly[] = [];\n  for (const [side, sign] of [[\"Right\", 1], [\"Left\", -1]] as [string, number][]) {\n    // Legs and posts sit outboard of the runners (runner occupies W/2 .. W/2+T).\n    const y0 = sign > 0 ? W / 2 + T : -W / 2 - 2 * T;\n    parts.push(new Assembly({ geometry: sideBoard(legPts, y0), color: wood, tags: [\"cutLayout\", \"leg\"], bom: [`${side} front leg`] }));\n    parts.push(new Assembly({ geometry: sideBoard(postPts, y0), color: wood, tags: [\"cutLayout\", \"post\"], bom: [`${side} rear post`] }));\n\n    const arm = armDrawing\n      .translate((armFront + armRear) / 2, (sign * (armIn + armOut)) / 2)\n      .sketchOnPlane(\"XY\")\n      .extrude(T)\n      .translate(0, 0, H - T);\n    parts.push(new Assembly({ geometry: arm, color: wood, tags: [\"cutLayout\", \"arm\"], bom: [`${side} arm`] }));\n  }\n\n  // Upper back batten: spans under both arms, rests on the rear posts.\n  const batten = replicad.makeBox([xBack, -armOut, H - 2 * T], [armRear, armOut, H - T]);\n  parts.push(new Assembly({ geometry: batten, color: wood, tags: [\"cutLayout\", \"batten\"], bom: [\"Upper back batten\"] }));\n  return parts;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Arms and legs: swept-back front legs, rear arm posts, an upper back batten, and two arms.\n * The back's rear face crosses arm height at xBack; the batten sits just behind it on\n * top of the rear posts, and the arms rest on the front legs and the batten.\n * Back pivot matches the Back molecule: seat rear bottom edge at (460, 300).\n * armHeight is the top of the arms above the floor.\n * legSweep is how far the front legs lean back from vertical (degrees); the foot sits\n * forward of the seat and the top lands well back under the arm.\n */\nfunction run(thickness = 19.05, seatWidth = 560, backAngle = 24, armHeight = 600, legSweep = 20, armWidth = 120) {\n    const T = thickness;\n    const W = seatWidth;\n    const H = armHeight;\n    const wood = \"#C8894F\";\n    const P = [460, 300];\n    const b = (backAngle * Math.PI) / 180;\n    const s = (legSweep * Math.PI) / 180;\n    // Rear face of the back where it meets the underside of the arms, plus 1 mm clearance.\n    const xBack = P[0] + T * Math.cos(b) + (H - T - (P[1] - T * Math.sin(b))) * Math.tan(b) + 1;\n    const postDepth = 100;\n    const armFront = -60;\n    const armRear = xBack + postDepth;\n    const armIn = W / 2 + 5; // clears the back panels\n    const armOut = armIn + armWidth;\n    // Board drawn in the side (XZ) view with its inner face at y0.\n    const sideBoard = (pts, y0) => {\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++)\n            pen = pen.lineTo(pts[i]);\n        const solid = pen.close().sketchOnPlane(\"XZ\").extrude(T);\n        const bb = solid.boundingBox.bounds;\n        return solid.translate(0, y0 - bb[0][1], 0);\n    };\n    // Front leg: a 90 mm wide board swept back by legSweep, cut level at the floor and under the arm.\n    const legWidth = 90;\n    const legFoot = -40; // front of the foot, ahead of the seat front\n    const wFlat = legWidth / Math.cos(s); // width measured along the level cuts\n    const rise = H - T;\n    const run_ = rise * Math.tan(s);\n    const legPts = [[legFoot, 0], [legFoot + wFlat, 0], [legFoot + wFlat + run_, rise], [legFoot + run_, rise]];\n    const postPts = [[xBack, 0], [xBack + postDepth, 0], [xBack + postDepth, H - 2 * T], [xBack, H - 2 * T]];\n    // Arm outline in plan: square rear, rounded front corners.\n    const armLen = armRear - armFront;\n    const armDrawing = replicad\n        .drawRoundedRectangle(armLen, armWidth, 45)\n        .fuse(replicad.drawRectangle(armLen / 2, armWidth).translate(armLen / 4, 0));\n    const parts = [];\n    for (const [side, sign] of [[\"Right\", 1], [\"Left\", -1]]) {\n        // Legs and posts sit outboard of the runners (runner occupies W/2 .. W/2+T).\n        const y0 = sign > 0 ? W / 2 + T : -W / 2 - 2 * T;\n        parts.push(new Assembly({ geometry: sideBoard(legPts, y0), color: wood, tags: [\"cutLayout\", \"leg\"], bom: [`${side} front leg`] }));\n        parts.push(new Assembly({ geometry: sideBoard(postPts, y0), color: wood, tags: [\"cutLayout\", \"post\"], bom: [`${side} rear post`] }));\n        const arm = armDrawing\n            .translate((armFront + armRear) / 2, (sign * (armIn + armOut)) / 2)\n            .sketchOnPlane(\"XY\")\n            .extrude(T)\n            .translate(0, 0, H - T);\n        parts.push(new Assembly({ geometry: arm, color: wood, tags: [\"cutLayout\", \"arm\"], bom: [`${side} arm`] }));\n    }\n    // Upper back batten: spans under both arms, rests on the rear posts.\n    const batten = replicad.makeBox([xBack, -armOut, H - 2 * T], [armRear, armOut, H - T]);\n    parts.push(new Assembly({ geometry: batten, color: wood, tags: [\"cutLayout\", \"batten\"], bom: [\"Upper back batten\"] }));\n    return parts;\n}\n"
        },
