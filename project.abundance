          ],
          "interpreterVersion": 1,
          "code": "/**\n * Back: two leaning back panels between the runners plus a lower batten behind them.\n * The panels' front face pivots on the seat's rear bottom edge and leans back by backAngle\n * from vertical. The seat rear is where the seat slope (0,380)->(460,300) ends.\n * backLength is the panel length above the pivot, measured along the lean.\n * The lower batten's end tabs (back-local 20..70 mm below the pivot) pass through slots\n * cut in the runners by the Frame molecule.\n */\nfunction run(\n  thickness: number = 19.05,\n  seatWidth: number = 560,\n  backAngle: number = 24,\n  backLength: number = 700,\n  gap: number = 6,\n): Assembly[] {\n  const T = thickness;\n  const W = seatWidth;\n  const wood = \"#C8894F\";\n  const P = [460, 300]; // seat rear bottom edge (x, z)\n  const below = 80; // panel length below the pivot, drops between the runners\n\n  // Boxes are built upright (X = thickness, Z = along the back) then leaned about Y.\n  const lean = (s: any) => s.rotate(backAngle, [0, 0, 0], [0, 1, 0]).translate(P[0], 0, P[1]);\n\n  const parts: Assembly[] = [];\n  for (const [side, y0, y1] of [[\"Right\", gap / 2, W / 2], [\"Left\", -W / 2, -gap / 2]] as [string, number, number][]) {\n    const panel = lean(replicad.makeBox([0, y0, -below], [T, y1, backLength]));\n    parts.push(new Assembly({ geometry: panel, color: wood, tags: [\"cutLayout\", \"back\"], bom: [`${side} back panel`] }));\n  }\n\n  // Lower batten: directly behind the panels at the bottom, tabs lock through the runners.\n  const batten = replicad\n    .makeBox([T, -W / 2, -below], [2 * T, W / 2, 20])\n    .fuse(replicad.makeBox([T, W / 2 - 1, -70], [2 * T, W / 2 + T, -20]))\n    .fuse(replicad.makeBox([T, -W / 2 - T, -70], [2 * T, -W / 2 + 1, -20]));\n  parts.push(new Assembly({ geometry: lean(batten), color: wood, tags: [\"cutLayout\", \"batten\"], bom: [\"Lower back batten\"] }));\n  return parts;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Back: two leaning back panels between the runners plus a lower batten behind them.\n * The panels' front face pivots on the seat's rear bottom edge and leans back by backAngle\n * from vertical. The seat rear is where the seat slope (0,380)->(460,300) ends.\n * backLength is the panel length above the pivot, measured along the lean.\n * The lower batten's end tabs (back-local 20..70 mm below the pivot) pass through slots\n * cut in the runners by the Frame molecule.\n */\nfunction run(thickness = 19.05, seatWidth = 560, backAngle = 24, backLength = 700, gap = 6) {\n    const T = thickness;\n    const W = seatWidth;\n    const wood = \"#C8894F\";\n    const P = [460, 300]; // seat rear bottom edge (x, z)\n    const below = 80; // panel length below the pivot, drops between the runners\n    // Boxes are built upright (X = thickness, Z = along the back) then leaned about Y.\n    const lean = (s) => s.rotate(backAngle, [0, 0, 0], [0, 1, 0]).translate(P[0], 0, P[1]);\n    const parts = [];\n    for (const [side, y0, y1] of [[\"Right\", gap / 2, W / 2], [\"Left\", -W / 2, -gap / 2]]) {\n        const panel = lean(replicad.makeBox([0, y0, -below], [T, y1, backLength]));\n        parts.push(new Assembly({ geometry: panel, color: wood, tags: [\"cutLayout\", \"back\"], bom: [`${side} back panel`] }));\n    }\n    // Lower batten: directly behind the panels at the bottom, tabs lock through the runners.\n    const batten = replicad\n        .makeBox([T, -W / 2, -below], [2 * T, W / 2, 20])\n        .fuse(replicad.makeBox([T, W / 2 - 1, -70], [2 * T, W / 2 + T, -20]))\n        .fuse(replicad.makeBox([T, -W / 2 - T, -70], [2 * T, -W / 2 + 1, -20]));\n    parts.push(new Assembly({ geometry: lean(batten), color: wood, tags: [\"cutLayout\", \"batten\"], bom: [\"Lower back batten\"] }));\n    return parts;\n}\n"
        }
